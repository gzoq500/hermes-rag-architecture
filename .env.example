# Required credentials and endpoint. Never commit real values.
ZILLIZ_URI=https://your-cluster.example.com:19532
ZILLIZ_TOKEN=replace-with-zilliz-token
GEMINI_API_KEY=replace-with-gemini-api-key

# Upstream and storage
ZILLIZ_COLLECTION=hermes_gemini_memory
HERMES_DB_PATH=/root/.hermes/state.db
ROUTER_BASE_URL=http://127.0.0.1:20130

# Embeddings
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=3072
GEMINI_TIMEOUT_SECONDS=10

# Context reduction and memory
RAG_RECENT_MESSAGES=24
RAG_RETRIEVAL_LIMIT=3
RAG_RETRIEVAL_MIN_CHARS=10
RAG_CHUNK_MAX_CHARS=8000
RAG_MINIMUM_INGEST_CHARS=15
RAG_MAX_INGEST_RECORDS_PER_REQUEST=32
RAG_RESET_COLLECTION=false

# Proxy runtime
UPSTREAM_TIMEOUT_SECONDS=120
RAG_LISTEN_HOST=0.0.0.0
RAG_LISTEN_PORT=20128
LOG_LEVEL=INFO
