[Unit]
Description=Hermes RAG Gateway (FastAPI to 9Router)
Wants=network-online.target
After=network-online.target 9router.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hermes-rag-architecture
EnvironmentFile=/etc/hermes-rag-gateway.env
ExecStart=/opt/hermes-rag-architecture/.venv/bin/python -m rag_gateway
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
UMask=0077

[Install]
WantedBy=multi-user.target
